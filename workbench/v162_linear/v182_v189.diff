+
+
+# Recovered research variant: keep the v186 codec and all calibrated state,
+# but use one fixed complete-64-block order for the activation GPTQ solve.
+# The order is derived from the deployed quantized weight's diagonal energy;
+# it is compiled once during weight calibration and never searched online.
+_STATIC_ACTORDER_BASE_CALIBRATION = hif4_calibration_and_quantize_weight
+_STATIC_ACTORDER_BASE_DYNAMIC = hif4_dynamic_quantize_activation
+
+
+@torch.no_grad()
+def _static_actorder_hdiag_order(
+    weight_quant: torch.Tensor,
+    weight_params: dict[str, torch.Tensor],
+    activation_state: Optional[dict[str, Any]] = None,
+) -> Optional[torch.Tensor]:
+    channels = int(weight_quant.shape[-1])
+    if channels % _HIF4_BLOCK_SIZE != 0:
+        return None
+    cached_importance = (
+        activation_state.get("importance")
+        if activation_state is not None
+        else None
+    )
+    if (
+        torch.is_tensor(cached_importance)
+        and int(cached_importance.numel()) == channels
+    ):
+        # v186 already stores normalized W_hat column energy for activation
+        # GPTQ; normalization does not change the block ordering.
+        h_diag = cached_importance.detach().to(torch.float32).reshape(-1)
+    else:
+        weight_hat = _dequantize_hif4(weight_params).to(torch.float32)
+        h_diag = weight_hat.square().sum(dim=0)
+    blocks = channels // _HIF4_BLOCK_SIZE
+    block_score = h_diag.reshape(blocks, _HIF4_BLOCK_SIZE).sum(dim=1)
+    return torch.argsort(
+        block_score, descending=True
+    ).to(device="cpu", dtype=torch.int16).contiguous()
+
+
+@torch.no_grad()
+def hif4_calibration_and_quantize_weight(
+    weight_quant: torch.Tensor,
+    weight_scale: torch.Tensor,
+    calib_activation_list: list,
+) -> dict[str, Any]:
+    result = _STATIC_ACTORDER_BASE_CALIBRATION(
+        weight_quant, weight_scale, calib_activation_list
+    )
+    state = result["activation_state"]
+    order = _static_actorder_hdiag_order(
+        weight_quant, result["weight_params"], state
+    )
+    if order is None:
+        return result
+    state["gptq_block_order"] = order
+    state["gptq_block_order_hdiag"] = True
+    print(
+        f"[STATIC-ACTORDER-HDIAG] reachable=1 blocks={int(order.numel())}",
+        flush=True,
+    )
+    return result
+
+
+@torch.no_grad()
+def _static_actorder_dense_from_state(
+    activation_quant: torch.Tensor,
+    activation_scale: torch.Tensor,
+    state: dict[str, Any],
+) -> torch.Tensor:
+    channels = int(activation_quant.shape[-1])
+    dense = _dequantize_nvfp4_float32(activation_quant, activation_scale)
+    if state.get("smooth_inv") is not None:
+        scale = _safe_positive_vector(
+            state["smooth_inv"], channels
+        ).to(dense.device)
+        dense.mul_(scale.reshape(*([1] * (dense.ndim - 1)), channels))
+    permutation = state.get("permutation")
+    if permutation is not None:
+        order = permutation.detach().to(
+            device=dense.device, dtype=torch.int64
+        ).reshape(-1)
+        if int(order.numel()) != channels:
+            raise ValueError("Permutation width does not match tensor width")
+        dense = dense.index_select(-1, order)
+    block_smooth_size = int(state.get("block_smooth_size", 0))
+    if block_smooth_size != 0:
+        dense = _block_hadamard_transform(
+            dense, block_smooth_size, int(state.get("block_smooth_seed", 0))
+        )
+    residual_u = state.get("residual_u")
+    residual_v = state.get("residual_v")
+    if residual_u is not None and residual_v is not None:
+        u = residual_u.to(device=dense.device, dtype=torch.float32)
+        v = residual_v.to(device=dense.device, dtype=torch.float32)
+        dense = dense + (dense @ u) @ v.transpose(0, 1)
+    else:
+        rank1_u = state["rank1_u"].to(
+            device=dense.device, dtype=torch.float32
+        ).reshape(-1)
+        rank1_v = state["rank1_v"].to(
+            device=dense.device, dtype=torch.float32
+        ).reshape(-1)
+        dense = dense + (dense @ rank1_u).unsqueeze(-1) * rank1_v
+    return dense
+
+
+@torch.no_grad()
+def _static_actorder_reordered_gptq(
+    dense: torch.Tensor,
+    state: dict[str, Any],
+) -> Optional[dict[str, torch.Tensor]]:
+    channels = int(dense.shape[-1])
+    if dense.ndim != 2 or channels % _HIF4_BLOCK_SIZE != 0:
+        return None
+    blocks = channels // _HIF4_BLOCK_SIZE
+    order_cpu = state["gptq_block_order"].detach().to(
+        device="cpu", dtype=torch.int64
+    ).reshape(-1)
+    if int(order_cpu.numel()) != blocks:
+        return None
+    if not torch.equal(
+        torch.sort(order_cpu).values,
+        torch.arange(blocks, dtype=torch.int64),
+    ):
+        return None
+
+    block_offsets = torch.arange(
+        channels // _HIF4_BLOCK_SIZE, dtype=torch.int64
+    )
+    channel_order = (
+        order_cpu[:, None] * _HIF4_BLOCK_SIZE
+        + torch.arange(_HIF4_BLOCK_SIZE, dtype=torch.int64)[None, :]
+    ).reshape(-1).to(device=dense.device)
+    h_inv_state = state.get("h_inv")
+    if h_inv_state is None:
+        return None
+    h_inv_ordered = h_inv_state.to(
+        device=dense.device, dtype=torch.float32
+    ).index_select(0, channel_order).index_select(1, channel_order)
+    dense_ordered = dense.index_select(-1, channel_order)
+
+    importance = state.get("importance")
+    if importance is not None:
+        importance = importance.detach().to(
+            device=dense.device, dtype=torch.float32
+        ).reshape(-1)
+        if int(importance.numel()) != channels:
+            return None
+        importance = importance.index_select(0, channel_order)
+
+    gram = state.get("gram")
+    gram_ordered = None
+    if gram is not None:
+        gram_ordered = gram.detach().to(
+            device=dense.device, dtype=torch.float32
+        ).reshape(blocks, 8, 2, 4, 4)
+        gram_ordered = gram_ordered.index_select(
+            0, order_cpu.to(device=dense.device)
+        ).unsqueeze(0).expand(
+            int(dense.shape[0]), blocks, 8, 2, 4, 4
+        )
+
+    params = _activation_gptq_quantize(
+        dense_ordered,
+        h_inv_ordered,
+        importance=importance,
+        group_gram=gram_ordered,
+        search_offsets=state.get("offsets"),
+        error_threshold=float(state.get("error_threshold", 0.0)),
+        accept_margin=float(state.get("accept_margin", 0.0)),
+        max_refine_ratio=float(state.get("max_refine_ratio", 0.0)),
+        max_refine_blocks=int(state.get("max_refine_blocks", 0)),
+    )
+    inverse = torch.empty_like(order_cpu)
+    inverse[order_cpu] = torch.arange(blocks, dtype=torch.int64)
+    inverse = inverse.to(device=dense.device)
+    return {
+        key: value.index_select(1, inverse)
+        for key, value in params.items()
+    }
+
+
+@torch.no_grad()
+def hif4_dynamic_quantize_activation(
+    activation_quant: torch.Tensor,
+    activation_scale: torch.Tensor,
+    activation_state: Any,
+) -> dict[str, torch.Tensor]:
+    if not isinstance(activation_state, dict):
+        raise TypeError("activation_state must be a dict")
+    if activation_state.get("gptq_block_order") is None:
+        return _STATIC_ACTORDER_BASE_DYNAMIC(
+            activation_quant, activation_scale, activation_state
+        )
+    try:
+        channels = int(activation_quant.shape[-1])
+        if channels != int(activation_state.get("in_features", -1)):
+            raise ValueError(
+                "Activation hidden size does not match calibration state"
+            )
+        dense = _static_actorder_dense_from_state(
+            activation_quant, activation_scale, activation_state
+        )
+        result = _static_actorder_reordered_gptq(dense, activation_state)
+        if result is not None:
+            return result
+    except (RuntimeError, ValueError, TypeError, IndexError):
+        pass
+    return _STATIC_ACTORDER_BASE_DYNAMIC(
+        activation_quant, activation_scale, activation_state
+    )
